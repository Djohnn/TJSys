{
  "name": "zyrp-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "api:generate": "openapi-typescript http://localhost:8000/api/v1/schema/ -o src/api/generated/schema.ts",
    "api:check": "openapi-typescript http://localhost:8000/api/v1/schema/ -o /tmp/schema-check.ts && diff /tmp/schema-check.ts src/api/generated/schema.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "decimal.js": "^10.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.82.0",
    "react-router-dom": "7.18.1",
    "tailwindcss": "^4.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "18.3",
    "@types/react-dom": "18.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "@types/jest-axe": "^3.5.3",
    "globals": "^17.7.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "@redocly/openapi-core": {
      "js-yaml": "4.3.0"
    }
  }
}
